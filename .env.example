# Copy to .env.local and fill in to switch the app from the local mock data
# provider to a real Supabase backend. See supabase/migrations/ for the
# schema that must be applied first, and src/services/index.ts for the
# provider switch.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: internally hosted OCR language data (traineddata) for fully
# offline/intranet operation. Leave unset to use tesseract.js's CDN default.
# See README "OCR offline betreiben".
VITE_TESSERACT_LANG_PATH=

# Optional: route repair-photo AI analysis through the idm-ai-agent Edge
# Function instead of analyze-repair-photo (prompt-injection hardened,
# adds an "uncertainties" field - see supabase/functions/idm-ai-agent/
# README.md). Leave unset/false until idm-ai-agent has been deployed and
# verified - analyze-repair-photo is the default and stays the fallback.
VITE_IDM_AI_AGENT_ENABLED=
